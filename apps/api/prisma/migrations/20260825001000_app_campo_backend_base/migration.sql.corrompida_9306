-- Base preparatória do futuro aplicativo corporativo de campo.
-- Nenhum endpoint, job ou coleta é ativado por esta migration.
CREATE TABLE "app_campo_dispositivos" ("id" BIGSERIAL PRIMARY KEY,"usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE CASCADE,"pessoa_id" UUID REFERENCES "pessoas"("id") ON DELETE SET NULL,"dispositivo_id" BIGINT REFERENCES "app_campo_dispositivos"("id") ON DELETE SET NULL,"evento_inicio_id" VARCHAR(120) NOT NULL UNIQUE,"evento_fim_id" VARCHAR(120) UNIQUE,"status" VARCHAR(20) NOT NULL DEFAULT 'ATIVO',"iniciado_dispositivo_em" TIMESTAMP(6) NOT NULL,"iniciado_servidor_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,"finalizado_dispositivo_em" TIMESTAMP(6),"finalizado_servidor_em" TIMESTAMP(6),"origem" VARCHAR(20) NOT NULL DEFAULT 'APP',CONSTRAINT "app_campo_expedientes_status_ck" CHECK ("status" IN ('ATIVO','PAUSADO','FINALIZADO','CANCELADO')),CONSTRAINT "app_campo_expedientes_origem_ck" CHECK ("origem" IN ('APP','WEB','SISTEMA')));
CREATE INDEX "app_campo_expedientes_usuario_status_idx" ON "app_campo_expedientes"("usuario_id","status"); CREATE INDEX "app_campo_expedientes_pessoa_inicio_idx" ON "app_campo_expedientes"("pessoa_id","iniciado_servidor_em");
CREATE TABLE "app_campo_pausas" ("id" BIGSERIAL PRIMARY KEY,"expediente_id" BIGINT NOT NULL REFERENCES "app_campo_expedientes"("id") ON DELETE CASCADE,"evento_inicio_id" VARCHAR(120) NOT NULL UNIQUE,"evento_fim_id" VARCHAR(120) UNIQUE,"motivo" VARCHAR(160),"iniciada_dispositivo_em" TIMESTAMP(6) NOT NULL,"iniciada_servidor_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,"finalizada_dispositivo_em" TIMESTAMP(6),"finalizada_servidor_em" TIMESTAMP(6)); CREATE INDEX "app_campo_pausas_expediente_inicio_idx" ON "app_campo_pausas"("expediente_id","iniciada_servidor_em");
CREATE TABLE "app_campo_telemetria" ("id" BIGSERIAL PRIMARY KEY,"evento_id" VARCHAR(120) NOT NULL UNIQUE,"usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE CASCADE,"pessoa_id" UUID REFERENCES "pessoas"("id") ON DELETE SET NULL,"expediente_id" BIGINT NOT NULL REFERENCES "app_campo_expedientes"("id") ON DELETE CASCADE,"dispositivo_id" BIGINT REFERENCES "app_campo_dispositivos"("id") ON DELETE SET NULL,"latitude" DECIMAL(10,7) NOT NULL,"longitude" DECIMAL(10,7) NOT NULL,"precisao_metros" DECIMAL(10,2),"altitude_metros" DECIMAL(10,2),"velocidade_metros_segundo" DECIMAL(10,3),"bateria_percentual" INTEGER,"carregando" BOOLEAN,"tipo_conexao" VARCHAR(30),"qualidade_sinal" INTEGER,"online" BOOLEAN,"capturado_em" TIMESTAMP(6) NOT NULL,"recebido_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,"anonimizado_em" TIMESTAMP(6),CONSTRAINT "app_campo_telemetria_bateria_ck" CHECK ("bateria_percentual" IS NULL OR "bateria_percentual" BETWEEN 0 AND 100),CONSTRAINT "app_campo_telemetria_latitude_ck" CHECK ("latitude" BETWEEN -90 AND 90),CONSTRAINT "app_campo_telemetria_longitude_ck" CHECK ("longitude" BETWEEN -180 AND 180));
CREATE INDEX "app_campo_telemetria_usuario_capturado_idx" ON "app_campo_telemetria"("usuario_id","capturado_em"); CREATE INDEX "app_campo_telemetria_pessoa_capturado_idx" ON "app_campo_telemetria"("pessoa_id","capturado_em"); CREATE INDEX "app_campo_telemetria_expediente_capturado_idx" ON "app_campo_telemetria"("expediente_id","capturado_em"); CREATE INDEX "app_campo_telemetria_anonimizado_idx" ON "app_campo_telemetria"("anonimizado_em");
CREATE TABLE "app_campo_evidencias" ("id" BIGSERIAL PRIMARY KEY,"evento_id" VARCHAR(120) NOT NULL UNIQUE,"usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE CASCADE,"pessoa_id" UUID REFERENCES "pessoas"("id") ON DELETE SET NULL,"expediente_id" BIGINT REFERENCES "app_campo_expedientes"("id") ON DELETE SET NULL,"entidade_tipo" VARCHAR(40) NOT NULL,"entidade_id" VARCHAR(100) NOT NULL,"tipo" VARCHAR(40) NOT NULL,"nome_original" VARCHAR(255),"nome_armazenado" VARCHAR(255),"caminho" VARCHAR(500),"mime_type" VARCHAR(120),"tamanho_bytes" BIGINT,"hash_sha256" VARCHAR(64),"latitude" DECIMAL(10,7),"longitude" DECIMAL(10,7),"capturado_em" TIMESTAMP(6),"recebido_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP); CREATE INDEX "app_campo_evidencias_entidade_idx" ON "app_campo_evidencias"("entidade_tipo","entidade_id"); CREATE INDEX "app_campo_evidencias_usuario_recebido_idx" ON "app_campo_evidencias"("usuario_id","recebido_em"); CREATE INDEX "app_campo_evidencias_expediente_idx" ON "app_campo_evidencias"("expediente_id");
CREATE TABLE "app_campo_eventos_offline" ("id" BIGSERIAL PRIMARY KEY,"evento_id" VARCHAR(120) NOT NULL UNIQUE,"usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE CASCADE,"dispositivo_id" BIGINT REFERENCES "app_campo_dispositivos"("id") ON DELETE SET NULL,"tipo" VARCHAR(60) NOT NULL,"entidade_tipo" VARCHAR(40),"entidade_id" VARCHAR(100),"payload_hash" VARCHAR(64),"status" VARCHAR(30) NOT NULL DEFAULT 'RECEBIDO',"ocorrido_em" TIMESTAMP(6) NOT NULL,"recebido_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,"processado_em" TIMESTAMP(6),"erro" TEXT,CONSTRAINT "app_campo_eventos_offline_status_ck" CHECK ("status" IN ('RECEBIDO','PROCESSADO','ERRO_REPROCESSAVEL','REJEITADO'))); CREATE INDEX "app_campo_eventos_offline_usuario_ocorrido_idx" ON "app_campo_eventos_offline"("usuario_id","ocorrido_em"); CREATE INDEX "app_campo_eventos_offline_status_recebido_idx" ON "app_campo_eventos_offline"("status","recebido_em");
CREATE TABLE "app_campo_acessos_localizacao" ("id" BIGSERIAL PRIMARY KEY,"consultor_usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE RESTRICT,"alvo_usuario_id" UUID NOT NULL REFERENCES "usuarios"("id") ON DELETE RESTRICT,"expediente_id" BIGINT REFERENCES "app_campo_expedientes"("id") ON DELETE SET NULL,"finalidade" VARCHAR(200) NOT NULL,"tipo_consulta" VARCHAR(30) NOT NULL,"periodo_inicio" TIMESTAMP(6),"periodo_fim" TIMESTAMP(6),"ip" VARCHAR(45),"user_agent" VARCHAR(500),"acessado_em" TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,CONSTRAINT "app_campo_acessos_tipo_ck" CHECK ("tipo_consulta" IN ('MAPA_ATUAL','HISTORICO','RELATORIO'))); CREATE INDEX "app_campo_acessos_consultor_idx" ON "app_campo_acessos_localizacao"("consultor_usuario_id","acessado_em"); CREATE INDEX "app_campo_acessos_alvo_idx" ON "app_campo_acessos_localizacao"("alvo_usuario_id","acessado_em");
INSERT INTO "perfis" ("id","codigo","nome","descricao","sistema","ativo","criado_em","atualizado_em") VALUES (gen_random_uuid(),'CAMPO','Usuário de Campo','Acesso futuro ao aplicativo corporativo de campo',TRUE,TRUE,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP),(gen_random_uuid(),'MOTORISTA_ENTREGADOR','Motorista/Entregador','Operações futuras de entrega em campo',TRUE,TRUE,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP),(gen_random_uuid(),'TECNICO','Técnico','Operações técnicas futuras em campo',TRUE,TRUE,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP),(gen_random_uuid(),'AUXILIAR','Auxiliar','Apoio futuro às operações de campo',TRUE,TRUE,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP),(gen_random_uuid(),'SUPERVISOR','Supervisor','Supervisão futura das operações de campo',TRUE,TRUE,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP) ON CONFLICT ("codigo") DO NOTHING;
INSERT INTO "permissoes" ("id","hub","modulo","acao","descricao","criado_em") VALUES (gen_random_uuid(),'APP_CAMPO','JORNADA','USAR','Gerenciar a própria jornada futura',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','ATIVIDADES','VISUALIZAR','Visualizar próprias atividades futuras',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','ATIVIDADES','EXECUTAR','Registrar execução futura de atividades',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','EVIDENCIAS','ENVIAR','Enviar evidências operacionais futuras',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','SINCRONIZACAO','USAR','Sincronizar eventos offline futuros',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','LOCALIZACAO','ENVIAR','Enviar localização durante jornada ativa futura',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','LOCALIZACAO','VISUALIZAR','Visualizar localização operacional autorizada',CURRENT_TIMESTAMP),(gen_random_uuid(),'APP_CAMPO','ADMINISTRACAO','GERENCIAR','Gerenciar configurações futuras do aplicativo',CURRENT_TIMESTAMP) ON CONFLICT ("hub","modulo","acao") DO NOTHING;
INSERT INTO "perfis_permissoes" ("perfil_id","permissao_id","efeito","criado_em") SELECT pf."id",pe."id",'PERMITIR',CURRENT_TIMESTAMP FROM "perfis" pf CROSS JOIN "permissoes" pe WHERE pf."codigo" IN ('CAMPO','MOTORISTA_ENTREGADOR','TECNICO','AUXILIAR') AND pe."hub"='APP_CAMPO' AND (pe."modulo",pe."acao") IN (('JORNADA','USAR'),('ATIVIDADES','VISUALIZAR'),('ATIVIDADES','EXECUTAR'),('EVIDENCIAS','ENVIAR'),('SINCRONIZACAO','USAR'),('LOCALIZACAO','ENVIAR')) ON CONFLICT ("perfil_id","permissao_id") DO NOTHING;
INSERT INTO "perfis_permissoes" ("perfil_id","permissao_id","efeito","criado_em") SELECT pf."id",pe."id",'PERMITIR',CURRENT_TIMESTAMP FROM "perfis" pf CROSS JOIN "permissoes" pe WHERE pf."codigo"='SUPERVISOR' AND pe."hub"='APP_CAMPO' AND NOT (pe."modulo"='ADMINISTRACAO' AND pe."acao"='GERENCIAR') ON CONFLICT ("perfil_id","permissao_id") DO NOTHING;
INSERT INTO "perfis_permissoes" ("perfil_id","permissao_id","efeito","criado_em") SELECT pf."id",pe."id",'PERMITIR',CURRENT_TIMESTAMP FROM "perfis" pf CROSS JOIN "permissoes" pe WHERE pf."codigo"='ADMINISTRADOR' AND pe."hub"='APP_CAMPO' ON CONFLICT ("perfil_id","permissao_id") DO NOTHING;
