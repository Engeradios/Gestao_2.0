generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  fotoPerfilCaminho           String?                  @map("foto_perfil_caminho") @db.VarChar(500)
  fotoPerfilMime              String?                  @map("foto_perfil_mime") @db.VarChar(100)
  fotoPerfilNomeOriginal      String?                  @map("foto_perfil_nome_original") @db.VarChar(255)
  fotoPerfilTamanho           Int?                     @map("foto_perfil_tamanho")
  contratosCriados            ContratoAdministrativo[] @relation("ContratoCriadoPor")
  contratosResponsaveis       ContratoAdministrativo[] @relation("ContratoResponsavel")
  contratosAtualizados        ContratoAdministrativo[] @relation("ContratoAtualizadoPor")
  contratoAndamentos          ContratoAndamento[]
  contratoDocumentosEnviados  ContratoDocumento[]      @relation("ContratoDocumentoEnviadoPor")
  contratoDocumentosExcluidos ContratoDocumento[]      @relation("ContratoDocumentoExcluidoPor")
  contratoConsultasCnpj       ContratoConsultaCnpj[]

  id                        String                         @id @default(uuid()) @db.Uuid
  nome                      String                         @db.VarChar(160)
  email                     String                         @unique @db.VarChar(200)
  senhaHash                 String                         @map("senha_hash") @db.VarChar(255)
  status                    StatusUsuario                  @default(ATIVO)
  unidade                   String?                        @db.VarChar(10)
  ultimoLoginEm             DateTime?                      @map("ultimo_login_em")
  criadoEm                  DateTime                       @default(now()) @map("criado_em")
  atualizadoEm              DateTime                       @updatedAt @map("atualizado_em")
  trocarSenha               Boolean                        @default(true) @map("trocar_senha")
  pessoaId                  String?                        @unique(map: "usuarios_pessoa_id_uq") @map("pessoa_id") @db.Uuid
  auditorias                Auditoria[]                    @relation("AuditoriaUsuario")
  perfis                    UsuarioPerfil[]
  pessoa                    Pessoa?                        @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  preferenciaNotificacao    PreferenciaNotificacaoUsuario?
  configuracoesEmail        ConfiguracaoEmail[]
  solicitacoesCriadas       Solicitacao[]                  @relation("SolicitacaoSolicitante")
  solicitacoesAtribuidas    Solicitacao[]                  @relation("SolicitacaoResponsavel")
  solicitacaoHistoricos     SolicitacaoHistorico[]
  emailLogs                 EmailLog[]
  notificacoes              NotificacaoUsuario[]
  tokensAutenticacao        TokenAutenticacao[]
  appCampoDispositivos      AppCampoDispositivo[]
  appCampoTermosAceites     AppCampoTermoAceite[]
  appCampoExpedientes       AppCampoExpediente[]
  appCampoTelemetrias       AppCampoTelemetria[]
  appCampoEvidencias        AppCampoEvidencia[]
  appCampoEventosOffline    AppCampoEventoOffline[]
  appCampoAcessosRealizados AppCampoAcessoLocalizacao[]    @relation("AppCampoAcessoConsultor")
  appCampoAcessosComoAlvo   AppCampoAcessoLocalizacao[]    @relation("AppCampoAcessoAlvo")

  @@index([status])
  @@map("usuarios")
}

model Perfil {
  id           String            @id @default(uuid()) @db.Uuid
  codigo       String            @unique @db.VarChar(60)
  nome         String            @db.VarChar(120)
  descricao    String?           @db.VarChar(255)
  sistema      Boolean           @default(false)
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")
  permissoes   PerfilPermissao[]
  usuarios     UsuarioPerfil[]

  @@map("perfis")
}

model Permissao {
  id        String            @id @default(uuid()) @db.Uuid
  hub       String            @db.VarChar(80)
  modulo    String            @db.VarChar(80)
  acao      String            @db.VarChar(80)
  descricao String?           @db.VarChar(255)
  criadoEm  DateTime          @default(now()) @map("criado_em")
  perfis    PerfilPermissao[]

  @@unique([hub, modulo, acao])
  @@index([hub, modulo])
  @@map("permissoes")
}

model UsuarioPerfil {
  usuarioId String   @map("usuario_id") @db.Uuid
  perfilId  String   @map("perfil_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em")
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([usuarioId, perfilId])
  @@index([perfilId])
  @@map("usuarios_perfis")
}

model PerfilPermissao {
  perfilId    String          @map("perfil_id") @db.Uuid
  permissaoId String          @map("permissao_id") @db.Uuid
  efeito      EfeitoPermissao @default(PERMITIR)
  criadoEm    DateTime        @default(now()) @map("criado_em")
  perfil      Perfil          @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao   Permissao       @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissaoId])
  @@index([permissaoId])
  @@map("perfis_permissoes")
}

model Auditoria {
  id          BigInt   @id @default(autoincrement())
  usuarioId   String?  @map("usuario_id") @db.Uuid
  entidade    String   @db.VarChar(100)
  entidadeId  String?  @map("entidade_id") @db.VarChar(100)
  acao        String   @db.VarChar(60)
  dadosAntes  Json?    @map("dados_antes")
  dadosDepois Json?    @map("dados_depois")
  ip          String?  @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  criadoEm    DateTime @default(now()) @map("criado_em")
  usuario     Usuario? @relation("AuditoriaUsuario", fields: [usuarioId], references: [id])

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("auditoria")
}

model ClienteOperacional {
  contratosAdministrativos ContratoAdministrativo[]

  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origem                String                 @db.VarChar(40)
  origemId              Int                    @map("origem_id")
  codigo                String?                @db.VarChar(40)
  razaoSocial           String                 @map("razao_social") @db.VarChar(255)
  nomeFantasia          String?                @map("nome_fantasia") @db.VarChar(255)
  cnpj                  String?                @db.VarChar(30)
  endereco              String?                @db.VarChar(255)
  bairro                String?                @db.VarChar(120)
  municipio             String?                @db.VarChar(120)
  uf                    String?                @db.Char(2)
  cep                   String?                @db.VarChar(20)
  contatoNome           String?                @map("contato_nome") @db.VarChar(160)
  contatoEmail          String?                @map("contato_email") @db.VarChar(200)
  contatoFone           String?                @map("contato_fone") @db.VarChar(60)
  website               String?                @db.VarChar(255)
  ativo                 Boolean                @default(true)
  origemCriadoEm        DateTime?              @map("origem_criado_em")
  origemAtualizadoEm    DateTime?              @map("origem_atualizado_em")
  sincronizadoEm        DateTime               @default(now()) @map("sincronizado_em")
  criadoEm              DateTime               @default(now()) @map("criado_em")
  atualizadoEm          DateTime               @default(now()) @updatedAt @map("atualizado_em")
  ordens                OrdemServico[]
  contratoConsultaCnpjs ContratoConsultaCnpj[]

  @@unique([origem, origemId])
  @@index([codigo])
  @@index([razaoSocial])
  @@index([cnpj])
  @@map("clientes_operacionais")
}

model OrdemServico {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origem              String                    @db.VarChar(40)
  origemId            Int                       @map("origem_id")
  numero              String                    @db.VarChar(60)
  clienteId           String?                   @map("cliente_id") @db.Uuid
  clienteCodigo       String?                   @map("cliente_codigo") @db.VarChar(40)
  clienteNome         String?                   @map("cliente_nome") @db.VarChar(255)
  local               String?                   @db.VarChar(100)
  telefone            String?                   @db.VarChar(60)
  cep                 String?                   @db.VarChar(20)
  uf                  String?                   @db.Char(2)
  tipo                String?                   @db.VarChar(255)
  situacao            String?                   @db.VarChar(120)
  faseNegociacao      String?                   @map("fase_negociacao") @db.VarChar(120)
  status              String?                   @db.VarChar(60)
  equipamento         String?
  produto             String?
  chamado             String?                   @db.VarChar(80)
  contrato            String?                   @db.VarChar(100)
  tipoContrato        String?                   @map("tipo_contrato") @db.VarChar(255)
  titulo              String?                   @db.VarChar(255)
  situacaoContrato    String?                   @map("situacao_contrato") @db.VarChar(120)
  enderecoObra        String?                   @map("endereco_obra")
  fatura              String?                   @db.VarChar(100)
  pedido              String?                   @db.VarChar(100)
  representante       String?                   @db.VarChar(160)
  valor               Decimal?                  @default(0) @db.Decimal(18, 2)
  abertura            DateTime?
  fechamento          DateTime?
  duracao             String?                   @db.VarChar(80)
  cadastro            DateTime?                 @db.Date
  cepEntrega          String?                   @map("cep_entrega") @db.VarChar(20)
  classificacao       String?                   @db.VarChar(120)
  tecnico             String?                   @db.VarChar(160)
  atendente           String?                   @db.VarChar(160)
  solicitante         String?                   @db.VarChar(160)
  terceiros           String?                   @db.VarChar(255)
  tipoConclusao       String?                   @map("tipo_conclusao") @db.VarChar(120)
  zonaAtuacao         String?                   @map("zona_atuacao") @db.VarChar(120)
  ultimaOrigem        String?                   @map("ultima_origem") @db.VarChar(120)
  solicitacao         String?
  laudo               String?
  conclusao           String?
  observacao          String?
  aceiteNome          String?                   @map("aceite_nome") @db.VarChar(160)
  aceiteEm            DateTime?                 @map("aceite_em")
  origemCriadoEm      DateTime?                 @map("origem_criado_em")
  origemAtualizadoEm  DateTime?                 @map("origem_atualizado_em")
  sincronizadoEm      DateTime                  @default(now()) @map("sincronizado_em")
  criadoEm            DateTime                  @default(now()) @map("criado_em")
  atualizadoEm        DateTime                  @default(now()) @updatedAt @map("atualizado_em")
  inicioExecucao      DateTime?                 @map("inicio_execucao")
  fimExecucao         DateTime?                 @map("fim_execucao")
  prazoEntrega        DateTime?                 @map("prazo_entrega")
  aceiteCargo         String?                   @map("aceite_cargo") @db.VarChar(120)
  aceiteSetor         String?                   @map("aceite_setor") @db.VarChar(120)
  aceiteDocumento     String?                   @map("aceite_documento") @db.VarChar(60)
  aceiteAprovado      Boolean?                  @map("aceite_aprovado")
  op_roteiro_entregas OpRoteiroEntrega[]
  cliente             ClienteOperacional?       @relation(fields: [clienteId], references: [id])
  equipamentos        OrdemServicoEquipamento[]

  @@unique([origem, origemId])
  @@index([numero])
  @@index([clienteCodigo])
  @@index([clienteNome])
  @@index([contrato])
  @@index([status, situacao])
  @@index([abertura])
  @@index([origemAtualizadoEm])
  @@map("ordens_servico")
}

model OrdemServicoEquipamento {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ordemServicoId   String       @map("ordem_servico_id") @db.Uuid
  origem           String       @db.VarChar(40)
  origemChave      String       @map("origem_chave") @db.VarChar(220)
  codigo           String?      @db.VarChar(80)
  descricao        String?
  numeroInterno    String?      @map("numero_interno") @db.VarChar(160)
  numeroFabricante String?      @map("numero_fabricante") @db.VarChar(160)
  marca            String?      @db.VarChar(120)
  modelo           String?      @db.VarChar(160)
  setor            String?      @db.VarChar(160)
  tipo             String       @default("EQUIPAMENTO") @db.VarChar(40)
  status           String?      @db.VarChar(80)
  sincronizadoEm   DateTime     @default(now()) @map("sincronizado_em")
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @default(now()) @updatedAt @map("atualizado_em")
  ordemServico     OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade, map: "os_equipamentos_ordem_servico_id_fkey")

  @@unique([origem, origemChave], map: "os_equipamentos_origem_chave_key")
  @@index([ordemServicoId], map: "os_equipamentos_ordem_servico_id_idx")
  @@map("ordens_servico_equipamentos")
}

model SincronizacaoOperacional {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo                    String    @db.VarChar(40)
  status                  String    @db.VarChar(30)
  iniciadoEm              DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm            DateTime? @map("finalizado_em")
  marcoAnterior           DateTime? @map("marco_anterior")
  marcoNovo               DateTime? @map("marco_novo")
  clientesLidos           Int       @default(0) @map("clientes_lidos")
  osLidas                 Int       @default(0) @map("os_lidas")
  equipamentosProcessados Int       @default(0) @map("equipamentos_processados")
  mensagem                String?
  detalhes                Json?

  @@index([iniciadoEm])
  @@index([status])
  @@map("sincronizacoes_operacionais")
}

model OpCliente {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo       Int?        @unique(where: raw("(codigo IS NOT NULL)"))
  razaoSocial  String      @map("razao_social") @db.VarChar(220)
  nomeFantasia String?     @map("nome_fantasia") @db.VarChar(220)
  cnpj         String?     @db.VarChar(30)
  endereco     String?
  bairro       String?     @db.VarChar(120)
  municipio    String?     @db.VarChar(120)
  uf           String?     @db.VarChar(2)
  cep          String?     @db.VarChar(20)
  contatoNome  String?     @map("contato_nome") @db.VarChar(160)
  contatoEmail String?     @map("contato_email") @db.VarChar(180)
  contatoFone  String?     @map("contato_fone") @db.VarChar(60)
  website      String?     @db.VarChar(255)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @default(now()) @updatedAt @map("atualizado_em")
  servicos     OpServico[]

  @@index([razaoSocial])
  @@index([uf])
  @@map("op_clientes")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model OpServico {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legadoId                 Int?                   @unique(where: raw("(legado_id IS NOT NULL)")) @map("legado_id")
  proposta                 String?                @db.VarChar(100)
  clienteId                String?                @map("cliente_id") @db.Uuid
  cliente                  String                 @db.VarChar(220)
  clienteLocal             String?                @map("cliente_local") @db.VarChar(220)
  dataAprovacao            DateTime?              @map("data_aprovacao") @db.Date
  diasPreparacao           Int                    @default(15) @map("dias_preparacao")
  tempoExecucaoDias        Int?                   @map("tempo_execucao_dias")
  tipoProposta             String?                @map("tipo_proposta") @db.VarChar(100)
  areaResponsavel          String?                @map("area_responsavel") @db.VarChar(20)
  prazoExecucaoDiasUteis   Int?                   @map("prazo_execucao_dias_uteis")
  ufExecucao               String                 @default("RJ") @map("uf_execucao") @db.VarChar(2)
  servicoAtividade         String                 @map("servico_atividade")
  categoria                String?                @db.VarChar(100)
  responsavel              String?                @db.VarChar(160)
  prioridade               String?                @db.VarChar(60)
  inicioPlanejado          DateTime?              @map("inicio_planejado") @db.Date
  prazoFinal               DateTime?              @map("prazo_final") @db.Date
  inicioReal               DateTime?              @map("inicio_real") @db.Date
  conclusaoReal            DateTime?              @map("conclusao_real") @db.Date
  status                   String                 @default("Não iniciado") @db.VarChar(80)
  percentual               Decimal                @default(0) @db.Decimal(5, 4)
  proximaAcao              String?                @map("proxima_acao")
  ultimaSituacao           String?                @map("ultima_situacao")
  observacoes              String?
  propostaPdf              String?                @map("proposta_pdf") @db.VarChar(255)
  propostaPdfNome          String?                @map("proposta_pdf_nome") @db.VarChar(255)
  propostaPdfEm            DateTime?              @map("proposta_pdf_em")
  abertoEm                 DateTime?              @map("aberto_em")
  notificadoEm             DateTime?              @map("notificado_em")
  criadoEm                 DateTime               @default(now()) @map("criado_em")
  atualizadoEm             DateTime               @default(now()) @updatedAt @map("atualizado_em")
  propostaId               Int?                   @unique(map: "op_servicos_proposta_id_uq") @map("proposta_id")
  emailAberturaStatus      String                 @default("PENDENTE") @map("email_abertura_status") @db.VarChar(20)
  emailConclusaoStatus     String                 @default("PENDENTE") @map("email_conclusao_status") @db.VarChar(20)
  emailAberturaTentativas  Int                    @default(0) @map("email_abertura_tentativas")
  emailConclusaoTentativas Int                    @default(0) @map("email_conclusao_tentativas")
  emailAberturaErro        String?                @map("email_abertura_erro")
  emailConclusaoErro       String?                @map("email_conclusao_erro")
  contrato                 String?                @db.VarChar(120)
  pedido                   String?                @db.VarChar(100)
  contatoNome              String?                @map("contato_nome") @db.VarChar(160)
  contatoEmail             String?                @map("contato_email") @db.VarChar(180)
  contatoTelefone          String?                @map("contato_telefone") @db.VarChar(80)
  enderecoInstalacao       String?                @map("endereco_instalacao") @db.VarChar(500)
  titulo                   String?                @db.VarChar(500)
  statusBase               String?                @map("status_base") @db.VarChar(80)
  ativo                    Boolean                @default(true)
  inativadoEm              DateTime?              @map("inativado_em")
  inativadoPor             String?                @map("inativado_por") @db.VarChar(160)
  emails                   OpEmailLog[]
  roteiroVisitas           OpRoteiroVisita[]
  andamentos               OpServicoAndamento[]
  historicos               OpServicoHistorico[]
  responsaveis             OpServicoResponsavel[]
  anexos                   OpServicoAnexo[]
  clienteCadastro          OpCliente?             @relation(fields: [clienteId], references: [id])
  propostaCadastro         OpProposta?            @relation(fields: [propostaId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([status])
  @@index([prazoFinal])
  @@index([responsavel])
  @@index([ufExecucao])
  @@index([propostaId])
  @@map("op_servicos")
}

model OpServicoResponsavel {
  servicoId    String    @map("servico_id") @db.Uuid
  pessoaId     String    @map("pessoa_id") @db.Uuid
  papel        String?   @db.VarChar(60)
  atribuidoPor String?   @map("atribuido_por") @db.VarChar(160)
  atribuidoEm  DateTime  @default(now()) @map("atribuido_em")
  ativo        Boolean   @default(true)
  servico      OpServico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  pessoa       Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Restrict)

  @@id([servicoId, pessoaId])
  @@index([pessoaId, ativo])
  @@map("op_servico_responsaveis")
}

model OpServicoAnexo {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  servicoId      String    @map("servico_id") @db.Uuid
  tipo           String    @default("DOCUMENTO") @db.VarChar(60)
  nomeOriginal   String    @map("nome_original") @db.VarChar(255)
  nomeArmazenado String    @map("nome_armazenado") @db.VarChar(255)
  mimeType       String?   @map("mime_type") @db.VarChar(120)
  tamanho        BigInt?
  caminho        String    @db.VarChar(500)
  hashSha256     String?   @map("hash_sha256") @db.VarChar(64)
  criadoPor      String?   @map("criado_por") @db.VarChar(160)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  ativo          Boolean   @default(true)
  servico        OpServico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId, criadoEm(sort: Desc)])
  @@map("op_servico_anexos")
}

model OpServicoAndamento {
  id              BigInt    @id @default(autoincrement())
  servicoId       String    @map("servico_id") @db.Uuid
  usuario         String    @db.VarChar(160)
  descricao       String
  percentual      Decimal?  @db.Decimal(5, 4)
  statusNoMomento String?   @map("status_no_momento") @db.VarChar(80)
  registradoEm    DateTime  @default(now()) @map("registrado_em")
  servico         OpServico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId, registradoEm])
  @@map("op_servico_andamentos")
}

model OpServicoHistorico {
  id            BigInt    @id @default(autoincrement())
  servicoId     String    @map("servico_id") @db.Uuid
  usuario       String    @db.VarChar(160)
  campo         String    @db.VarChar(120)
  valorAntigo   String?   @map("valor_antigo")
  valorNovo     String?   @map("valor_novo")
  situacao      String?   @db.VarChar(80)
  diasRestantes Int?      @map("dias_restantes")
  registradoEm  DateTime  @default(now()) @map("registrado_em")
  servico       OpServico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId, registradoEm])
  @@map("op_servico_historicos")
}

model OpLista {
  id           BigInt   @id @default(autoincrement())
  tipo         String   @db.VarChar(40)
  nome         String   @db.VarChar(160)
  ordem        Int      @default(0)
  cor          String?  @db.VarChar(7)
  unidade      String?  @db.VarChar(2)
  funcao       String?  @db.VarChar(60)
  ativo        Boolean  @default(true)
  pessoaId     String?  @map("pessoa_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")
  pessoa       Pessoa?  @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  @@unique([tipo, nome])
  @@index([tipo, ordem, nome])
  @@index([pessoaId])
  @@map("op_listas")
