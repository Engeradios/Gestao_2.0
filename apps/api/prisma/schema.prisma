  frete             Decimal              @default(0) @db.Decimal(15, 2)
  desconto          Decimal              @default(0) @db.Decimal(15, 2)
  valorProdutos     Decimal              @default(0) @map("valor_produtos") @db.Decimal(15, 2)
  valorTotal        Decimal              @default(0) @map("valor_total") @db.Decimal(15, 2)
  observacoes       String?
  usuarioId         String?              @map("usuario_id") @db.Uuid
  usuarioNome       String               @map("usuario_nome") @db.VarChar(200)
  confirmadoEm      DateTime?            @map("confirmado_em") @db.Timestamp(6)
  criadoEm          DateTime             @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm      DateTime             @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)
  fornecedor        ComprasFornecedor    @relation(fields: [fornecedorId], references: [id], onDelete: Restrict)
  itens             ComprasPedidoItem[]
  recebimentos      ComprasRecebimento[]

  @@index([fornecedorId, status])
  @@index([status, previsaoEntrega])
  @@map("compras_pedidos")
}

model ComprasPedidoItem {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId           String                   @map("pedido_id") @db.Uuid
  produtoCodigo      String                   @map("produto_codigo") @db.VarChar(120)
  produtoDescricao   String                   @map("produto_descricao") @db.VarChar(500)
  quantidade         Decimal                  @db.Decimal(15, 4)
  quantidadeRecebida Decimal                  @default(0) @map("quantidade_recebida") @db.Decimal(15, 4)
  valorUnitario      Decimal                  @map("valor_unitario") @db.Decimal(15, 4)
  desconto           Decimal                  @default(0) @db.Decimal(15, 2)
  valorTotal         Decimal                  @map("valor_total") @db.Decimal(15, 2)
  status             String                   @default("PENDENTE") @db.VarChar(40)
  criadoEm           DateTime                 @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm       DateTime                 @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)
  pedido             ComprasPedido            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  rateios            ComprasPedidoRateio[]
  recebimentoItens   ComprasRecebimentoItem[]

  @@unique([pedidoId, produtoCodigo])
  @@index([produtoCodigo])
  @@index([status])
  @@map("compras_pedido_itens")
}

model ComprasPedidoRateio {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoItemId          String            @map("pedido_item_id") @db.Uuid
  comprasPropostaItemId String            @map("compras_proposta_item_id") @db.Uuid
  quantidade            Decimal           @db.Decimal(15, 4)
  criadoEm              DateTime          @default(now()) @map("criado_em") @db.Timestamp(6)
  pedidoItem            ComprasPedidoItem @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)

  @@unique([pedidoItemId, comprasPropostaItemId])
  @@index([comprasPropostaItemId])
  @@map("compras_pedido_rateios")
}

model ComprasRecebimento {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedidoId        String                   @map("pedido_id") @db.Uuid
  numeroDocumento String?                  @map("numero_documento") @db.VarChar(100)
  dataRecebimento DateTime                 @map("data_recebimento") @db.Timestamp(6)
  status          String                   @default("RASCUNHO") @db.VarChar(40)
  observacoes     String?
  usuarioId       String?                  @map("usuario_id") @db.Uuid
  usuarioNome     String                   @map("usuario_nome") @db.VarChar(200)
  confirmadoEm    DateTime?                @map("confirmado_em") @db.Timestamp(6)
  criadoEm        DateTime                 @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm    DateTime                 @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)
  pedido          ComprasPedido            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  itens           ComprasRecebimentoItem[]

  @@index([pedidoId, dataRecebimento(sort: Desc)])
  @@index([status])
  @@map("compras_recebimentos")
}

model ComprasRecebimentoItem {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recebimentoId      String             @map("recebimento_id") @db.Uuid
  pedidoItemId       String             @map("pedido_item_id") @db.Uuid
  quantidadeRecebida Decimal            @map("quantidade_recebida") @db.Decimal(15, 4)
  quantidadeAvariada Decimal            @default(0) @map("quantidade_avariada") @db.Decimal(15, 4)
  quantidadeRecusada Decimal            @default(0) @map("quantidade_recusada") @db.Decimal(15, 4)
  divergencia        String?
  lote               String?            @db.VarChar(100)
  numeroSerie        String?            @map("numero_serie") @db.VarChar(255)
  criadoEm           DateTime           @default(now()) @map("criado_em") @db.Timestamp(6)
  recebimento        ComprasRecebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  pedidoItem         ComprasPedidoItem  @relation(fields: [pedidoItemId], references: [id], onDelete: Restrict)

  @@unique([recebimentoId, pedidoItemId])
  @@index([pedidoItemId])
  @@map("compras_recebimento_itens")
}
