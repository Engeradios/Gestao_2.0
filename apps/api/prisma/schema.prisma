/// Base preparatória para futuro aplicativo corporativo de campo.
/// Estes modelos não ativam coleta, uploads, tarefas ou endpoints.
model AppCampoDispositivo {
  id               BigInt                  @id @default(autoincrement())
  usuarioId        String                  @map("usuario_id") @db.Uuid
  pessoaId         String?                 @map("pessoa_id") @db.Uuid
  identificador    String                  @unique @db.VarChar(120)
  plataforma       String                  @db.VarChar(20)
  modelo           String?                 @db.VarChar(120)
  fabricante       String?                 @db.VarChar(120)
  versaoSistema    String?                 @map("versao_sistema") @db.VarChar(80)
  versaoAplicativo String?                 @map("versao_aplicativo") @db.VarChar(40)
  corporativo      Boolean                 @default(false)
  ativo            Boolean                 @default(true)
  ultimoAcessoEm   DateTime?               @map("ultimo_acesso_em") @db.Timestamp(6)
  criadoEm         DateTime                @default(now()) @map("criado_em") @db.Timestamp(6)
  atualizadoEm     DateTime                @default(now()) @map("atualizado_em") @db.Timestamp(6)
  usuario          Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pessoa           Pessoa?                 @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  expedientes      AppCampoExpediente[]
  telemetrias      AppCampoTelemetria[]
  termosAceites    AppCampoTermoAceite[]
  eventosOffline   AppCampoEventoOffline[]

  @@index([usuarioId, ativo])
  @@index([pessoaId])
